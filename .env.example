# GitHub — public repos & stats (no token required for basic API)
VITE_GITHUB_USERNAME=JDjire
# Optional GitHub fine-grained token for reliable live API access.
# Keep this value private and never commit your .env file.
VITE_GITHUB_TOKEN=

# EmailJS — https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Optional: Formspree fallback (https://formspree.io/)
VITE_FORMSPREE_ENDPOINT=
